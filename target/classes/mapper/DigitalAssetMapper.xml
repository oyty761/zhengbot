<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guzheng.explore.mapper.DigitalAssetMapper">

    <resultMap id="BaseResultMap" type="com.guzheng.explore.entity.DigitalAsset">
        <id column="id" property="id"/>
        <result column="asset_kind" property="assetKind"/>
        <result column="storage_uri" property="storageUri"/>
        <result column="mime_type" property="mimeType"/>
        <result column="checksum_sha256" property="checksumSha256"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, asset_kind, storage_uri, mime_type, checksum_sha256, duration_ms, created_at
        FROM digital_asset
        WHERE id = #{id}
    </select>

    <select id="selectFirstByKind" resultMap="BaseResultMap">
        SELECT id, asset_kind, storage_uri, mime_type, checksum_sha256, duration_ms, created_at
        FROM digital_asset
        WHERE asset_kind = #{assetKind}
        ORDER BY id ASC
        LIMIT 1
    </select>
</mapper>
