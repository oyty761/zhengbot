<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guzheng.mapper.HistorySongMapper">

    <resultMap id="BaseResultMap" type="com.guzheng.entity.HistorySong">
        <id column="history_entry_id" property="historyEntryId"/>
        <id column="song_id" property="songId"/>
        <result column="display_order" property="displayOrder"/>
    </resultMap>

    <select id="selectByHistoryEntryId" resultMap="BaseResultMap">
        SELECT history_entry_id, song_id, display_order
        FROM history_song
        WHERE history_entry_id = #{historyEntryId}
        ORDER BY display_order ASC
    </select>
</mapper>
