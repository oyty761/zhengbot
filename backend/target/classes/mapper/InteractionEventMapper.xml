<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guzheng.mapper.InteractionEventMapper">

    <resultMap id="BaseResultMap" type="com.guzheng.entity.InteractionEvent">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="event_type" property="eventType"/>
        <result column="source_module" property="sourceModule"/>
        <result column="target_module" property="targetModule"/>
        <result column="source_id" property="sourceId"/>
        <result column="target_id" property="targetId"/>
        <result column="payload" property="payload"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO interaction_event (session_id, event_type, source_module, target_module, source_id, target_id, payload, created_at)
        VALUES (#{sessionId}, #{eventType}, #{sourceModule}, #{targetModule}, #{sourceId}, #{targetId}, #{payload}, #{createdAt})
    </insert>
</mapper>
