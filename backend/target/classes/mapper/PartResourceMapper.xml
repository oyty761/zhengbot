<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guzheng.explore.mapper.PartResourceMapper">

    <resultMap id="BaseResultMap" type="com.guzheng.explore.entity.PartResource">
        <id column="part_id" property="partId"/>
        <id column="asset_id" property="assetId"/>
        <result column="resource_role" property="resourceRole"/>
        <result column="display_order" property="displayOrder"/>
    </resultMap>

    <select id="selectByPartIdAndRole" resultMap="BaseResultMap">
        SELECT part_id, asset_id, resource_role, display_order
        FROM part_resource
        WHERE part_id = #{partId}
          AND resource_role = #{resourceRole}
        ORDER BY display_order ASC
    </select>
</mapper>
